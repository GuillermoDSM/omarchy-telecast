+// PauseAudio asks the RTP audio loop to send FLUSH and stop transmitting audio.
+// Video continues independently. This is the AirPlay transport pause, not a
+// receiver volume change or a local mute.
+func (s *MirrorSession) PauseAudio() error {
+	if s == nil || s.client == nil || s.audioStream == nil || s.noAudio {
+		return fmt.Errorf("audio pause unavailable")
+	}
+	s.audioStream.mu.Lock()
+	s.audioStream.pauseRequested = true
+	s.audioStream.mu.Unlock()
+	return nil
+}
+
+// ResumeAudio asks the RTP audio loop to send RECORD and resume transmitting.
+func (s *MirrorSession) ResumeAudio() error {
+	if s == nil || s.client == nil || s.audioStream == nil || s.noAudio {
+		return fmt.Errorf("audio resume unavailable")
+	}
+	s.audioStream.mu.Lock()
+	s.audioStream.resumeRequested = true
+	s.audioStream.mu.Unlock()
+	return nil
+}
+
+func (s *MirrorSession) setAudioTransport(method string, seq uint16, rtpTime uint32) error {
+	headers := map[string]string{
+		"RTP-Info": fmt.Sprintf("seq=%d;rtptime=%d", seq, rtpTime),
+	}
+	if method == "RECORD" {
+		headers["Range"] = "npt=0-"
+	}
+	_, _, err := s.client.rtspRequest(method, s.sessionURI, "", nil, headers)
+	if err != nil {
+		return fmt.Errorf("%s audio: %w", method, err)
+	}
+	return nil
+}
